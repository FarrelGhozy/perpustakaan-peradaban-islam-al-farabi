% Basis data bibliografi BibTeX.
% ATURAN KERAS:
% 1. Setiap entri WAJIB terverifikasi (lihat ../log/catatan_verifikasi.md).
% 2. Dilarang mengarang penulis, judul, jurnal, volume, halaman, tahun, DOI, URL.
% 3. Verifikasi silang via Crossref API: curl -s "https://api.crossref.org/works/<doi>"
%    dan cek status HTTP setiap URL (hanya 200 yang diterima).
% 4. Entri yang hanya diperiksa dari judul/abstrak TANPA teks penuh:
%    tandai dengan field note = {belum verifikasi teks penuh} dan JANGAN disitasi
%    untuk klaim penting sampai teks penuh diperiksa.
%
% Contoh entri valid (JANGAN pakai sebelum diverifikasi!):
% @book{gutas1998,
%   author    = {Dimitri Gutas},
%   title     = {Greek Thought, Arabic Culture},
%   publisher = {Routledge},
%   year      = {1998},
%   address   = {London},
% }
